{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-aapp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "36e09f54-2678-4ab9-af0f-6534af587262","database_name": "web-aapp" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "2c4c4a145a034d8ca9c4dde5ab9d9cf1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
